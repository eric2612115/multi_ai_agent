# Application Settings
APP_NAME="AI Knowledge Forest"
APP_VERSION="1.0.0"
ENVIRONMENT="development"  # development, production

# API Settings
API_FRONTEND_URL="http://localhost:5173"  # Updated to match Vite default port
API_DEBUG_MODE=true
API_ENABLE_MCP=true

# AI Model Settings
AI_DEFAULT_SERVICE="gemini"  # gemini, claude, firecrawl
AI_MAX_TOKENS=1024
AI_ENABLE_ADVANCED_MODELS=true
AI_EMBEDDING_DIMENSIONS=768

# Gemini API Settings
AI_GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"  # Compatibility with both naming patterns
GEMINI_PRIMARY_MODEL="gemini-2.0-flash-thinking-exp-01-21"
GEMINI_ENHANCED_MODEL="gemini-2.5-pro-exp-03-25"
GEMINI_IMAGE_MODEL="gemini-2.0-flash-exp-image-generation"

# Claude API Settings
AI_CLAUDE_API_KEY="your_claude_api_key_here"
ANTHROPIC_API_KEY="your_claude_api_key_here"  # Compatibility with both naming patterns
ANTHROPIC_MODEL="claude-3-7-sonnet-20250219"

# Firecrawl API Settings
AI_FIRECRAWL_API_KEY="your_firecrawl_api_key_here"
FIRECRAWL_API_KEY="your_firecrawl_api_key_here"  # Compatibility with both naming patterns
AI_FIRECRAWL_API_URL="https://api.firecrawl.dev"

# Database Settings
DB_MONGODB_URI="mongodb://localhost:27017"
DB_MONGODB_DB="multi_ai_agent"
DB_REDIS_URI="redis://localhost:6379/0"
DB_ENABLE_VECTOR_SEARCH=false  # Set to true only if using MongoDB Atlas with vector search
DB_VECTOR_SEARCH_INDEX="nodes_vector_index"
DB_NODE_SIMILARITY_THRESHOLD=0.7

# Security Settings
SECURITY_JWT_SECRET_KEY="your_jwt_secret_key_here"  # Generate a strong random key for production
SECURITY_JWT_ALGORITHM="HS256"
SECURITY_ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# Knowledge Forest Settings
FOREST_THRESHOLD_EXTEND=0.85
FOREST_THRESHOLD_BRANCH=0.70
FOREST_THRESHOLD_CROSSLINK=0.80
FOREST_MAX_CROSSLINK_DISTANCE=3
FOREST_ENABLE_AUTO_CLASSIFICATION=true

# Knowledge Lifecycle Settings
LIFECYCLE_NODE_DORMANCY_THRESHOLD=0.2  # Nodes with importance below this go dormant
LIFECYCLE_NODE_MIN_AGE_DAYS=7  # Minimum age for nodes to be considered for dormancy
LIFECYCLE_ENABLE_AUTO_PRUNING=true  # Automatically run pruning during reflection
LIFECYCLE_PRUNING_INTERVAL_HOURS=24  # How often to run pruning checks
LIFECYCLE_REVIVAL_THRESHOLD=0.5  # Similarity threshold to revive dormant nodes

# Reflection Settings
REFLECTION_ENABLE_AUTONOMOUS=true  # Enable autonomous reflection cycles
REFLECTION_CYCLE_INTERVAL_HOURS=6  # Run reflection every 6 hours
REFLECTION_IDLE_TRIGGER_MINUTES=30  # Trigger reflection after 30 minutes of system idle
REFLECTION_ENERGY_BUDGET_DEFAULT=100  # Default energy budget for reflection tasks
REFLECTION_MIN_NODES_FOR_CYCLE=10  # Minimum nodes before starting reflection cycles

# Abstraction Settings
ABSTRACTION_MIN_CLUSTER_SIZE=3  # Minimum nodes to form an abstraction cluster
ABSTRACTION_SIMILARITY_THRESHOLD=0.7  # Similarity threshold for clustering
ABSTRACTION_MAX_LEVEL=5  # Maximum abstraction level (1-5)
ABSTRACTION_ENABLE_AUTO_GENERATION=true  # Auto-generate abstractions during reflection

# Innovation Settings
INNOVATION_ENABLE_CONCEPT_SYNTHESIS=true  # Enable concept synthesis/innovation
INNOVATION_NOVELTY_THRESHOLD=0.3  # Novelty threshold for accepting innovations
INNOVATION_COHERENCE_THRESHOLD=0.6  # Coherence threshold for accepting innovations
INNOVATION_MAX_DAILY=10  # Maximum innovations to generate per day

# Balance Settings
BALANCE_ENABLE_AUTO_BALANCE=true  # Enable auto-balancing of knowledge graph
BALANCE_BALANCE_INTERVAL_HOURS=12  # Run balance cycle every 12 hours
BALANCE_TARGET_TOPIC_RATIO=0.2  # Target ratio between largest and smallest topics

# Evaluation Settings
EVALUATION_ENABLE_AUTO_OPTIMIZATION=true  # Enable auto-optimization based on evaluation results
EVALUATION_EVALUATION_INTERVAL_HOURS=24  # Run system evaluation every 24 hours

# Server Settings (for direct uvicorn run)
PORT=8000
HOST="0.0.0.0"
